generator client {
  provider = "prisma-client-js"
}

generator drizzle {
  provider = "drizzle-prisma-generator"
  output   = "./src/v2/indexers/drizzle" // Where to put generated Drizle tables
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_CONNECTION_STRING")
}

model claims {
  id          Int      @id @default(autoincrement())
  block_number Int
  txIndex      Int
  eventIndex   Int
  txHash       String
  eventKey     String
  contract     String
  claimee      String
  amount       String
  timestamp    Int
  cursor       BigInt? @map("_cursor")

  @@unique([block_number, txIndex, eventIndex], name: "event_id")
  @@index([claimee], type: Hash)
}
